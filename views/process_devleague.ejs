
<%- include('partials/header.ejs'); %>

<% 
	const ready_room = signups.active;
	const waiting_room = signups.waiting;

	const stat_colors = {
		'great': 'text-success',
		'ok': 'text-info',
		'neutral': 'text-warning',
		'bad': 'text-danger',
		'none': 'text-muted',
	};
	let analysis = 'none';
	let table_class = "table-success";
%> 

	<style type="text/css">
		td a.move-arrow-back {
			text-decoration:none;
			font-size: xx-large;
			color: #6c757d;
		}
		td a.move-arrow {
			text-decoration:none;
			font-size: xx-large;
			color: #6c757d;
		}
		td:hover a.move-arrow {
			color: var(--bs-cyan) !important;
		}
		td:hover a.move-arrow-back {
			color: var(--bs-red) !important;
		}
	</style>

	<svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
		<symbol id="check-circle-fill" fill="currentColor" viewBox="0 0 16 16">
			<path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
		</symbol>
		<symbol id="exclamation-triangle-fill" fill="currentColor" viewBox="0 0 16 16">
			<path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
		</symbol>
	</svg>

	<main class="container-fluid">
		<div class="py-3 py-md-5 pb-md-2">
			<h2>DevLeague Lobby Manager</h2>
			<p class="lead">
				Every player that checks in for Dev League is placed in the "Waiting Room". 
				At 8:05pm, make a large enough lobby (prioritizing FAs) and press the Generate 
				Teams button.
			</p>
		</div>

		<%- include('partials/devleague/status.ejs', { 
				HTMX_REQUEST: HTMX_REQUEST ?? false,
				league: 3, 
				ready_room: ready_room,
		}); %>

		<div class="row" id="room_lists" style="min-height: 400px;">

			<div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-5 mt-5 mt-lg-0">
				<%- include('partials/devleague/waiting.ejs', { 
					HTMX_REQUEST: HTMX_REQUEST ?? false,
					league: 3, 
					waiting_room: waiting_room, 
					ready_room: ready_room, 
					include_games: false, 
					game_count: games.length, 
					stat_colors: stat_colors, 
				}); %>
			</div>

			<!-- primary FA signup / team generation -->
			<div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-6 order-first">
				<%- include('partials/devleague/ready.ejs', { 
					HTMX_REQUEST: HTMX_REQUEST ?? false,
					league: 3, 
					ready_room: ready_room, 
					include_games: false, 
					game_count: games.length, 
					stat_colors: stat_colors, 
				}); %> 
			</div>

		</div>

	</main>

	<%- include('partials/footer.ejs'); %>
